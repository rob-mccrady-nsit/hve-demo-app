@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Overview <span>/</span> @DateTime.Now.ToString("dddd, MMMM d")</p>
        <h1>Dashboard</h1>
        <p class="page-intro">A clear read on today's stock and sales.</p>
    </div>
    <a class="button button-primary" href="/sales/record">Record a sale <span aria-hidden="true">+</span></a>
</section>

<section class="metric-grid" aria-label="Inventory summary">
    <article class="metric">
        <span class="metric-label">Products</span>
        <strong class="metric-value">@Model.Summary.TotalProducts</strong>
        <span class="metric-note">Active catalog</span>
    </article>
    <article class="metric">
        <span class="metric-label">Stock value</span>
        <strong class="metric-value">@Model.Summary.StockValue.ToString("C", CultureInfo.GetCultureInfo("en-US"))</strong>
        <span class="metric-note">At current unit prices</span>
    </article>
    <article class="metric">
        <span class="metric-label">Revenue</span>
        <strong class="metric-value">@Model.Summary.TotalRevenue.ToString("C", CultureInfo.GetCultureInfo("en-US"))</strong>
        <span class="metric-note">All recorded sales</span>
    </article>
    <article class="metric metric-alert">
        <span class="metric-label">Needs reorder</span>
        <strong class="metric-value">@Model.Summary.LowStockProducts.Count</strong>
        <span class="metric-note">At or below reorder level</span>
    </article>
</section>

<section class="dashboard-grid">
    <article class="surface-panel">
        <div class="section-heading">
            <div><p class="eyebrow">Inventory watch</p><h2>Low stock</h2></div>
            <a class="text-link" href="/products">All products <span aria-hidden="true">→</span></a>
        </div>
        @if (Model.Summary.LowStockProducts.Count == 0)
        {
            <div class="empty-state"><span class="empty-mark">✓</span><p>Every product is above its reorder level.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Product</th><th>SKU</th><th>In stock</th><th>Reorder at</th></tr></thead>
                    <tbody>
                    @foreach (var product in Model.Summary.LowStockProducts)
                    {
                        <tr>
                            <td><a class="table-primary" href="/products/edit/@product.Id">@product.Name</a><span class="table-secondary">@product.Category</span></td>
                            <td class="mono">@product.Sku</td>
                            <td><span class="stock-count @(product.QuantityInStock == 0 ? "stock-empty" : "stock-low")">@product.QuantityInStock</span></td>
                            <td>@product.ReorderLevel</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </article>

    <article class="surface-panel">
        <div class="section-heading">
            <div><p class="eyebrow">Latest activity</p><h2>Recent sales</h2></div>
            <a class="text-link" href="/sales">Sales history <span aria-hidden="true">→</span></a>
        </div>
        @if (Model.Summary.RecentSales.Count == 0)
        {
            <div class="empty-state"><span class="empty-mark">$</span><p>No sales have been recorded yet.</p></div>
        }
        else
        {
            <div class="sales-feed">
            @foreach (var sale in Model.Summary.RecentSales)
            {
                <div class="sale-row">
                    <div><strong>@sale.ProductName</strong><span>@sale.QuantitySold sold <span class="mono">· @sale.Sku</span></span></div>
                    <div class="sale-amount"><strong>@sale.TotalAmount.ToString("C", CultureInfo.GetCultureInfo("en-US"))</strong><span>@sale.SaleDate.ToString("MMM d, h:mm tt")</span></div>
                </div>
            }
            </div>
        }
    </article>
</section>
