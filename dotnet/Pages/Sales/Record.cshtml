@page "/sales/record"
@model Stockroom.Pages.Sales.RecordModel
@{
    ViewData["Title"] = "Record sale";
}

<section class="page-heading">
    <div><p class="eyebrow"><a href="/sales">Sales</a> <span>/</span> New transaction</p><h1>Record a sale</h1><p class="page-intro">Stock is deducted when the transaction is saved.</p></div>
</section>

<section class="surface-panel form-panel">
    @if (Model.Products.Count == 0)
    {
        <div class="empty-state empty-large"><span class="empty-mark">+</span><h2>No products available</h2><p>Add a product to the catalog before recording a sale.</p><a class="button button-primary" href="/products/add">Add a product</a></div>
    }
    else
    {
        <form method="post" class="product-form sale-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-grid">
                <div class="field field-wide">
                    <label asp-for="ProductId">Product</label>
                    <select asp-for="ProductId">
                        <option value="0">Select a product</option>
                        @foreach (var product in Model.Products)
                        {
                            <option value="@product.Id">@product.Name · @product.Sku · @product.QuantityInStock in stock · @product.UnitPrice.ToString("C", CultureInfo.GetCultureInfo("en-US"))</option>
                        }
                    </select>
                    <span asp-validation-for="ProductId"></span>
                </div>
                <div class="field quantity-field"><label asp-for="Quantity">Quantity sold</label><input asp-for="Quantity" min="1"><span asp-validation-for="Quantity"></span></div>
            </div>
            <div class="form-actions"><button class="button button-primary" type="submit">Record sale</button><a class="button button-secondary" href="/sales">Cancel</a></div>
        </form>
    }
</section>